#!/usr/bin/env bash
# modpack-blacklist — Apply your personal Minecraft mod profile to a Prism Launcher instance
#
# Usage: modpack-blacklist [OPTIONS] <instance-name-or-path>
#
# Dependencies: curl, jq, rsync
#
# Config lives in ~/.config/modpack-blacklist/ (override with $MODPACK_BLACKLIST_DIR):
#   mods.txt             Mods to install (slug + optional min MC version)
#   resourcepacks.txt    Resource packs to install (slug, one per line)
#   blocklist.txt        Mod slugs to disable
#   configs/             Config files to copy into the instance's config/ dir
#   options-patch.txt    key:value pairs merged into options.txt (keybinds, etc.)

set -euo pipefail

# ── Paths ─────────────────────────────────────────────────────────────────────
PROFILE_DIR="${MODPACK_BLACKLIST_DIR:-$HOME/.config/modpack-blacklist}"
MODS_LIST="$PROFILE_DIR/mods.txt"
RESOURCE_PACKS_LIST="$PROFILE_DIR/resourcepacks.txt"
BLOCKLIST="$PROFILE_DIR/blocklist.txt"
CONFIGS_DIR="$PROFILE_DIR/configs"
OPTIONS_PATCH="$PROFILE_DIR/options-patch.txt"
PRISM_DIR="${PRISM_DIR:-$HOME/.local/share/PrismLauncher/instances}"
MODRINTH_API="https://api.modrinth.com/v2"
UA="modpack-blacklist/1.0 (personal instance automation)"

# ── Runtime state ─────────────────────────────────────────────────────────────
INSTANCE_PATH=""
MC_VERSION=""
LOADER=""
GAME_DIR=""
MODS_DIR=""
OPTIONS_FILE=""
CONFIG_DIR_INST=""

# Tracks slugs already installed or queued this run (prevents dup dep installs)
declare -A _QUEUED=()

# ── Flags ─────────────────────────────────────────────────────────────────────
DRY_RUN=false

# ── Terminal helpers ───────────────────────────────────────────────────────────
bold()   { printf '\033[1m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
ok()     { printf '  \033[32m✓\033[0m  %s\n' "$*"; }
skip()   { printf '  \033[33m⊘\033[0m  %s\n' "$*"; }
warn()   { printf '  \033[33m⚠\033[0m  %s\n' "$*"; }
err()    { printf '  \033[31m✗\033[0m  %s\n' "$*" >&2; }
dry()    { printf '  \033[34m~\033[0m  [dry] %s\n' "$*"; }
info()   { printf '  %s\n' "$*"; }
dep()    { printf '  \033[34m↳\033[0m  dep: %s\n' "$*"; }

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
$(bold "modpack-blacklist") — Apply your personal mod profile to a Prism Launcher instance

$(bold USAGE)
  modpack-blacklist [OPTIONS] <instance>

  <instance> is either an instance name (looked up inside your Prism instances
  directory) or a full path to an instance folder. Fuzzy name matching is
  supported — "atm9" will find "All the Mods 9".

$(bold OPTIONS)
  -n, --dry-run     Show what would happen without writing anything
  -h, --help        Show this help

$(bold CONFIG DIR)  $PROFILE_DIR
  mods.txt             Mods to install — <slug> [min-mc-version]
  resourcepacks.txt    Resource packs to install — one slug per line
  blocklist.txt        Mod slugs to disable — one per line
  configs/             Config files rsync'd into the game's config/ dir
  options-patch.txt    key:value lines merged into options.txt

$(bold EXAMPLES)
  modpack-blacklist "All the Mods 9"
  modpack-blacklist --dry-run ~/Games/prism/instances/ATM9
  modpack-blacklist -n MyNewPack

$(bold ENVIRONMENT)
  MODPACK_BLACKLIST_DIR    Override config dir (default: ~/.config/modpack-blacklist)
  PRISM_DIR                Override Prism instances dir
EOF
}

# ── Dependency check ───────────────────────────────────────────────────────────
check_deps() {
  local missing=()
  command -v curl  &>/dev/null || missing+=(curl)
  command -v jq    &>/dev/null || missing+=(jq)
  command -v rsync &>/dev/null || missing+=(rsync)
  if [[ ${#missing[@]} -gt 0 ]]; then
    err "Missing dependencies: ${missing[*]}"
    err "Install with: sudo pacman -S ${missing[*]}"
    exit 1
  fi
}

# ── Semver: returns 0 (true) if $1 >= $2 ──────────────────────────────────────
version_gte() {
  [[ "$(printf '%s\n' "$1" "$2" | sort -V | head -1)" == "$2" ]]
}

# ── Resolve instance name/path to INSTANCE_PATH ───────────────────────────────
resolve_instance() {
  local input="$1"

  if [[ -d "$input" ]]; then
    INSTANCE_PATH="$(realpath "$input")"
  elif [[ -d "$PRISM_DIR/$input" ]]; then
    INSTANCE_PATH="$PRISM_DIR/$input"
  else
    local match
    match=$(find "$PRISM_DIR" -maxdepth 1 -type d -iname "*${input}*" 2>/dev/null | head -1)
    if [[ -n "$match" ]]; then
      INSTANCE_PATH="$match"
    else
      err "Instance not found: '$input'"
      err "Looked in: $PRISM_DIR"
      exit 1
    fi
  fi

  info "Instance : $INSTANCE_PATH"
}

# ── Parse mmc-pack.json → MC_VERSION + LOADER + GAME_DIR ─────────────────────
parse_instance_meta() {
  local pack_json="$INSTANCE_PATH/mmc-pack.json"

  if [[ ! -f "$pack_json" ]]; then
    err "No mmc-pack.json found — is this a valid Prism/MultiMC instance?"
    exit 1
  fi

  MC_VERSION=$(jq -r '
    .components[]
    | select(.uid == "net.minecraft")
    | .cachedVersion // .version
  ' "$pack_json")

  local loader_uid
  loader_uid=$(jq -r '
    .components[]
    | select(.uid | test("fabric-loader|forge|neoforge|quilt"))
    | .uid
  ' "$pack_json" 2>/dev/null | head -1)

  case "$loader_uid" in
    *fabric*)   LOADER="fabric"   ;;
    *neoforge*) LOADER="neoforge" ;;
    *forge*)    LOADER="forge"    ;;
    *quilt*)    LOADER="quilt"    ;;
    *)
      warn "Loader not detected — defaulting to fabric"
      LOADER="fabric"
      ;;
  esac

  # Detect game directory. Priority:
  # 1. instance.cfg GameDir= (authoritative when explicitly set)
  # 2. Whichever of minecraft/ or .minecraft/ actually has a mods/ subfolder
  # 3. minecraft/ if it exists bare
  # 4. .minecraft/ as last-resort (will be created on first launch)
  local custom
  custom=$(grep "^GameDir=" "$INSTANCE_PATH/instance.cfg" 2>/dev/null | cut -d= -f2 || true)
  if [[ -n "$custom" && -d "$INSTANCE_PATH/$custom" ]]; then
    GAME_DIR="$INSTANCE_PATH/$custom"
  elif [[ -d "$INSTANCE_PATH/minecraft/mods" ]]; then
    GAME_DIR="$INSTANCE_PATH/minecraft"
  elif [[ -d "$INSTANCE_PATH/.minecraft/mods" ]]; then
    GAME_DIR="$INSTANCE_PATH/.minecraft"
  elif [[ -d "$INSTANCE_PATH/minecraft" ]]; then
    GAME_DIR="$INSTANCE_PATH/minecraft"
  else
    GAME_DIR="$INSTANCE_PATH/.minecraft"
  fi

  MODS_DIR="$GAME_DIR/mods"
  OPTIONS_FILE="$GAME_DIR/options.txt"
  CONFIG_DIR_INST="$GAME_DIR/config"

  info "MC version : $MC_VERSION"
  info "Loader     : $LOADER"
  info "Game dir   : $GAME_DIR"
}

# ── Modrinth: all filenames ever released for a project (any version) ─────────
# Used to detect an already-installed older version whose filename doesn't
# contain the slug.
modrinth_all_filenames() {
  local slug="$1"
  curl -sf "$MODRINTH_API/project/$slug/version" \
    -H "User-Agent: $UA" \
    2>/dev/null \
  | jq -r '.[].files[].filename' 2>/dev/null || true
}

# ── Modrinth: filename<TAB>url for a mod slug ─────────────────────────────────
modrinth_get_download() {
  local slug="$1"
  curl -sf -G \
    "$MODRINTH_API/project/$slug/version" \
    --data-urlencode "game_versions=[\"$MC_VERSION\"]" \
    --data-urlencode "loaders=[\"$LOADER\"]" \
    -H "User-Agent: $UA" \
    2>/dev/null \
  | jq -r '
    .[0]
    | if . == null then ""
      else
        (.files | (map(select(.primary)) | .[0]) // .[0])
        | "\(.filename)\t\(.url)"
      end
  ' 2>/dev/null || echo ""
}

# ── Modrinth: required dependency project IDs for a mod slug ──────────────────
modrinth_get_required_deps() {
  local slug="$1"
  curl -sf -G \
    "$MODRINTH_API/project/$slug/version" \
    --data-urlencode "game_versions=[\"$MC_VERSION\"]" \
    --data-urlencode "loaders=[\"$LOADER\"]" \
    -H "User-Agent: $UA" \
    2>/dev/null \
  | jq -r '
    .[0].dependencies // []
    | map(select(.dependency_type == "required"))
    | .[].project_id
  ' 2>/dev/null || true
}

# ── Modrinth: project_id → slug ───────────────────────────────────────────────
modrinth_project_slug() {
  local project_id="$1"
  curl -sf "$MODRINTH_API/project/$project_id" \
    -H "User-Agent: $UA" \
    2>/dev/null \
  | jq -r '.slug // ""' 2>/dev/null || echo ""
}

# ── Modrinth: filename<TAB>url for a resource pack slug ───────────────────────
# Resource packs aren't loader-specific; tries with game_version first,
# falls back to latest if no version-matched result.
modrinth_get_resourcepack_download() {
  local slug="$1"
  local result

  result=$(curl -sf -G \
    "$MODRINTH_API/project/$slug/version" \
    --data-urlencode "game_versions=[\"$MC_VERSION\"]" \
    -H "User-Agent: $UA" \
    2>/dev/null \
  | jq -r '
    .[0]
    | if . == null then ""
      else (.files | (map(select(.primary)) | .[0]) // .[0]) | "\(.filename)\t\(.url)"
      end
  ' 2>/dev/null || echo "")

  # No version-specific release — grab the latest unconditionally
  if [[ -z "$result" ]]; then
    result=$(curl -sf \
      "$MODRINTH_API/project/$slug/version" \
      -H "User-Agent: $UA" \
      2>/dev/null \
    | jq -r '
      .[0]
      | if . == null then ""
        else (.files | (map(select(.primary)) | .[0]) // .[0]) | "\(.filename)\t\(.url)"
        end
    ' 2>/dev/null || echo "")
  fi

  echo "$result"
}

# ── Install a single mod + its required deps (recursive, cycle-safe) ───────────
install_single_mod() {
  local slug="$1"
  local is_dep="${2:-false}"

  # Already handled this slug this run — skip
  if [[ -n "${_QUEUED[$slug]+x}" ]]; then
    return
  fi
  _QUEUED[$slug]=1

  local label="$slug"
  $is_dep && label="$slug  [dep]"

# Already on disk? — fast check by slug pattern
  local existing
  existing=$(find "$MODS_DIR" -maxdepth 1 -iname "*${slug}*.jar" \
    ! -name "*.disabled" 2>/dev/null | head -1)

  # Slug didn't appear in the filename — compare against every filename
  # Modrinth has ever published for this project (catches older modpack versions)
  if [[ -z "$existing" ]]; then
    local known_filename
    while IFS= read -r known_filename; do
      [[ -z "$known_filename" ]] && continue
      if [[ -f "$MODS_DIR/$known_filename" ]]; then
        existing="$MODS_DIR/$known_filename"
        break
      fi
    done < <(modrinth_all_filenames "$slug")
  fi

  if [[ -n "$existing" ]]; then
    skip "$label  (already present: ${existing##*/})"
    return
  fi

  # Fetch from Modrinth
  local result filename url
  result=$(modrinth_get_download "$slug")

  if [[ -z "$result" ]]; then
    warn "$label  (no release found for MC $MC_VERSION / $LOADER)"
    return
  fi

  filename=$(printf '%s' "$result" | cut -f1)
  url=$(printf '%s' "$result" | cut -f2)

  if $DRY_RUN; then
    $is_dep && dep "$slug  → $filename" || dry "$slug  → $filename"
  else
    curl -sf -L -o "$MODS_DIR/$filename" "$url" -H "User-Agent: $UA"
    $is_dep && dep "$slug  → $filename" || ok "$slug  → $filename"
  fi

  # Resolve and install required dependencies (only one level from explicit mods,
  # but deps can pull their own deps since cycles are guarded by _QUEUED)
  if ! $is_dep; then
    local dep_id dep_slug
    while IFS= read -r dep_id; do
      [[ -z "$dep_id" ]] && continue
      dep_slug=$(modrinth_project_slug "$dep_id")
      [[ -z "$dep_slug" ]] && continue
      install_single_mod "$dep_slug" true
    done < <(modrinth_get_required_deps "$slug")
  fi
}

# ── Step 1: Install QoL mods ──────────────────────────────────────────────────
install_mods() {
  if [[ ! -f "$MODS_LIST" ]]; then
    warn "mods.txt not found — skipping mod install  ($MODS_LIST)"
    return
  fi

  bold "Installing mods"
  $DRY_RUN || mkdir -p "$MODS_DIR"

  while IFS= read -r line; do
    line="${line%%#*}"
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -z "$line" ]] && continue

    local slug min_ver=""
    read -r slug min_ver <<< "$line"

    if [[ -n "$min_ver" ]] && ! version_gte "$MC_VERSION" "$min_ver"; then
      skip "$slug  (requires $min_ver+, pack is $MC_VERSION)"
      continue
    fi

    install_single_mod "$slug" false

  done < "$MODS_LIST"
}

# ── Step 2: Install resource packs ────────────────────────────────────────────
install_resourcepacks() {
  if [[ ! -f "$RESOURCE_PACKS_LIST" ]]; then
    warn "resourcepacks.txt not found — skipping  ($RESOURCE_PACKS_LIST)"
    return
  fi

  bold "Installing resource packs"
  local rp_dir="$GAME_DIR/resourcepacks"
  $DRY_RUN || mkdir -p "$rp_dir"

  while IFS= read -r line; do
    line="${line%%#*}"
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -z "$line" ]] && continue

    local slug="$line"

    # Already present?
    local existing
    existing=$(find "$rp_dir" -maxdepth 1 \
      \( -iname "*${slug}*" \) 2>/dev/null | head -1)
    if [[ -n "$existing" ]]; then
      skip "$slug  (already present: ${existing##*/})"
      continue
    fi

    local result filename url
    result=$(modrinth_get_resourcepack_download "$slug")

    if [[ -z "$result" ]]; then
      warn "$slug  (not found on Modrinth)"
      continue
    fi

    filename=$(printf '%s' "$result" | cut -f1)
    url=$(printf '%s' "$result" | cut -f2)

    if $DRY_RUN; then
      dry "$slug  → $filename"
    else
      curl -sf -L -o "$rp_dir/$filename" "$url" -H "User-Agent: $UA"
      ok "$slug  → $filename"
    fi

  done < "$RESOURCE_PACKS_LIST"
}

# ── Step 3: Disable blocklisted mods ──────────────────────────────────────────
apply_blocklist() {
  if [[ ! -f "$BLOCKLIST" ]]; then
    warn "blocklist.txt not found — skipping  ($BLOCKLIST)"
    return
  fi
  if [[ ! -d "$MODS_DIR" ]]; then
    warn "Mods directory doesn't exist yet — skipping blocklist"
    return
  fi

  bold "Applying blocklist"

  while IFS= read -r line; do
    line="${line%%#*}"
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -z "$line" ]] && continue

    local slug="$line"
    local found=false

    while IFS= read -r jarfile; do
      found=true
      local basename="${jarfile##*/}"
      if $DRY_RUN; then
        dry "Would disable: $basename"
      else
        mv "$jarfile" "${jarfile}.disabled"
        ok "$slug  → ${basename}.disabled"
      fi
    done < <(find "$MODS_DIR" -maxdepth 1 -iname "*${slug}*.jar" \
               ! -name "*.disabled" 2>/dev/null)

    if ! $found; then
      local already_disabled
      already_disabled=$(find "$MODS_DIR" -maxdepth 1 \
        -iname "*${slug}*.jar.disabled" 2>/dev/null | head -1)
      if [[ -n "$already_disabled" ]]; then
        skip "$slug  (already disabled)"
      else
        info "$slug  (not in this pack)"
      fi
    fi

  done < "$BLOCKLIST"
}

# ── Step 4: Rsync config files ────────────────────────────────────────────────
apply_configs() {
  if [[ ! -d "$CONFIGS_DIR" ]]; then
    warn "configs/ dir not found — skipping  ($CONFIGS_DIR)"
    return
  fi

  bold "Applying configs"
  $DRY_RUN || mkdir -p "$CONFIG_DIR_INST"

  if $DRY_RUN; then
    rsync -rn --out-format="  $(printf '\033[34m~\033[0m') [dry] %n" \
      "$CONFIGS_DIR/" "$CONFIG_DIR_INST/"
  else
    rsync -r --out-format="  $(printf '\033[32m✓\033[0m') %n" \
      "$CONFIGS_DIR/" "$CONFIG_DIR_INST/"
  fi
}

# ── Step 5: Patch options.txt (keybinds, video, etc.) ─────────────────────────
apply_options_patch() {
  if [[ ! -f "$OPTIONS_PATCH" ]]; then
    warn "options-patch.txt not found — skipping  ($OPTIONS_PATCH)"
    return
  fi

  bold "Patching options.txt"

  if ! $DRY_RUN; then
    mkdir -p "$(dirname "$OPTIONS_FILE")"
    touch "$OPTIONS_FILE"
  fi

  while IFS= read -r line; do
    line="${line%%#*}"
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -z "$line" ]] && continue
    [[ "$line" != *:* ]] && continue

    local key="${line%%:*}"
    local val="${line#*:}"

    if $DRY_RUN; then
      dry "$key:$val"
      continue
    fi

    if grep -q "^${key}:" "$OPTIONS_FILE" 2>/dev/null; then
      sed -i "s|^${key}:.*|${key}:${val}|" "$OPTIONS_FILE"
    else
      echo "${key}:${val}" >> "$OPTIONS_FILE"
    fi
    ok "$key:$val"

  done < "$OPTIONS_PATCH"
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
  local instance_arg=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run) DRY_RUN=true ;;
      -h|--help)    usage; exit 0 ;;
      -*)           err "Unknown flag: $1"; echo ""; usage; exit 1 ;;
      *)            instance_arg="$1" ;;
    esac
    shift
  done

  [[ -z "$instance_arg" ]] && { usage; exit 1; }

  check_deps

  echo ""
  bold "modpack-blacklist"
  $DRY_RUN && yellow "  (dry run — nothing will be written)"
  echo ""

  resolve_instance "$instance_arg"
  parse_instance_meta
  echo ""

  install_mods
  echo ""
  install_resourcepacks
  echo ""
  apply_blocklist
  echo ""
  apply_configs
  echo ""
  apply_options_patch
  echo ""

  if $DRY_RUN; then
    yellow "Dry run complete. Re-run without -n to apply changes."
  else
    green "Done! Launch the instance and enjoy your sane setup."
  fi
  echo ""
}

main "$@"
